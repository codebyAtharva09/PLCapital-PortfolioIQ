# Copy this file to .env and replace the placeholder with your key.
# .env is git-ignored: never put a real key in this template.
GEMINI_API_KEY=your_gemini_api_key_here

# Pinned model ID, checked against Google's Gemini docs on 2026-11-06.
# gemini-3.8-flash is newer but returned 503/504 ("high demand") in testing on 2026-11-06.
GEMINI_MODEL=gemini-3.6-flash
